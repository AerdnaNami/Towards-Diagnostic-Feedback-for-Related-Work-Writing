{
  "base_model": "meta-llama/Llama-3.1-8B",
  "output_root": "./runs",

  "defaults": {
    "max_length": 2048,
    "per_device_train_batch_size": 1,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 32,
    "learning_rate": 0.00005,
    "num_train_epochs": 3,
    "warmup_ratio": 0.03,
    "logging_steps": 25,
    "save_steps": 500,
    "save_reason": "A100 QLoRA SFT periodic checkpoint",
    "bf16": true,
    "fp16": false,
    "repetition_penalty": 1.3,
    "no_repeat_ngram_size": 8,

    "lora_r": 32,
    "lora_alpha": 16,
    "lora_dropout": 0.1,

    "flash_attn": false,
    "torch_compile": false,
    "dataloader_num_workers": 4,
    "max_grad_norm": 1.0,

    "eval_split": "eval",
    "early_stopping_patience": 3,
    "early_stopping_threshold": 0.0
  },

  "categories": [
    {
      "name": "Unsupported_claim",
      "train_path": "data/unsupported_claim/unsupported_claim_ner_train_long_6plus_prompt.json",
      "eval_path": "data/unsupported_claim/unsupported_claim_ner_eval_long_6plus_prompt.json",
      "run_name": "4_unsupported_long_llama3.1_8b_sft"
    },
    {
      "name": "Unsupported_claim",
      "train_path": "data/unsupported_claim/unsupported_claim_ner_train_short_1_5w_prompt.json",
      "eval_path": "data/unsupported_claim/unsupported_claim_ner_eval_short_1_5w_prompt.json",
      "run_name": "4_unsupported_short_llama3.1_8b_sft"
    },
    {
      "name": "Format",
      "train_path": "data/format/format_training_data.json",
      "eval_path": "data/format/format_eval_data.json",
      "run_name": "4_format_llama3.1_8b_sft"
    }
  ]
}
